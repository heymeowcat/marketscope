{
  "name": "marketscope",
  "version": "1.0.0",
  "description": "MarketScope — AI-Native Stock Trading & Portfolio Analytics Platform (BC-AINE-006)",
  "main": "dist/src/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/src/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.{ts,js}' || true",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:arch": "depcruise --config .dependency-cruiser.js src",
    "test:e2e": "playwright test",
    "seed": "tsx scripts/seed.ts",
    "agent:sprint": "node scripts/agent_sdk_runner.js",
    "verify": "npm run typecheck && npm run test:arch && npm run test:coverage && npm run test:e2e"
  },
  "keywords": [
    "fintech",
    "trading",
    "portfolio-analytics",
    "claude-harness",
    "ai-native"
  ],
  "author": "MarketScope Engineering Team",
  "license": "UNLICENSED",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "decimal.js": "^10.4.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.0.0",
    "uuid": "^14.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.20.0",
    "@playwright/test": "^1.43.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^5.0.2",
    "dependency-cruiser": "^16.3.0",
    "supertest": "^6.3.4",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^5.0.2"
  }
}